{
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "media-ai": {
      "root": "services/media-ai"
    }
  },
  "rewrites": [
    {
      "source": "/api/media-ai(/.*)?",
      "destination": {
        "type": "service",
        "service": "media-ai"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}
