{
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "media-ai": {
      "root": "services/media-ai",
      "framework": "fastapi",
      "entrypoint": "app/main.py"
    }
  },
  "rewrites": [
    {
      "source": "/api/media-ai(/.*)?",
      "destination": {
        "type": "service",
        "service": "media-ai"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/tv/youtube/channels/scheduled-sync",
      "schedule": "0 6 * * *"
    }
  ]
}
